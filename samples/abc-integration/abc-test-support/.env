# ------------------------------------------------------------------
# Abc Service connection configuration
# Used by AbcServiceProxy (via dotenv) to connect to the Abc backend
# ------------------------------------------------------------------
# SECURITY NOTE - Do NOT commit this file to version control if it contains sensitive information (e.g., passwords). Consider using environment variables when running tests.
# THIS FILE IS FOR DEMONSTRATION PURPOSES ONLY TO SHOW WHICH ENVIRONMENT VARIABLE ARE NEEDED AND SHOULD BE PROTECTED IN ALL ENVIRONMENTS.
# ------------------------------------------------------------------

# Base URL of the Abc service (HTTP endpoint)
# Example: http://localhost:8080
ABC_SERVICE_BASE_URL=http://localhost:8080

# Basic-auth username for the Abc service
ABC_SERVICE_BASIC_AUTH_USERNAME=admin

# Basic-auth password for the Abc service
ABC_SERVICE_BASIC_AUTH_PASSWORD=changeme
